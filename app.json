{
  "expo": {
    "name": "Mi Ciudad",
    "slug": "mi-ciudad",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "miciudad",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.miciudad.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B6E8C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "bundleIdentifier": "com.miciudad.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B6E8C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Mi Ciudad usa Face ID para que vuelvas a entrar a tu cuenta sin escribir la contraseña."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Mi Ciudad usa Face ID para que vuelvas a entrar a tu cuenta sin escribir la contraseña."
        }
      ],
      "@react-native-vector-icons/ionicons",
      "expo-sqlite",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Mi Ciudad usa tus fotos para elegir tu foto de perfil o la foto de una visita.",
          "cameraPermission": "Mi Ciudad usa la cámara para escanear el código QR del cartel de un lugar, sacar la foto de tus visitas y tu foto de perfil.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Mi Ciudad usa la cámara para escanear el código QR del cartel de un lugar, sacar la foto de tus visitas y tu foto de perfil.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Mi Ciudad usa tu ubicación para mostrarte qué lugares tenés cerca, indicarte hacia dónde queda cada uno y registrar una visita por cercanía.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notificacion-icono.png",
          "color": "#0B6E8C"
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": false
        }
      ],
      "expo-web-browser",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
